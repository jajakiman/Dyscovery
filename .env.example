NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Gemini API key dari https://aistudio.google.com/apikey (server-only, jangan pakai prefix NEXT_PUBLIC_)
GEMINI_API_KEY=
# Opsional, default gemini-3.8-flash
GEMINI_MODEL=

# Pengaturan gerbang pemrosesan AI (Security Rules §7)
ENABLE_AI_PROCESSING=true
AI_PROVIDER_COMPLIANCE_CONFIRMED=true
